# Local development: the Express API runs on port 4000.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.IO origin. Set this in production when NEXT_PUBLIC_API_URL is a
# same-origin path such as /api/v1, because the web host does not proxy
# WebSocket upgrades.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional same-origin proxy. Leave unset for normal local development.
# API_PROXY_TARGET=http://localhost:4000
